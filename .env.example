# RabbitMQ (default: amqp://localhost:5672)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# PostgreSQL — один контейнер, разные БД на сервис
# account, words, games подключаются к своей базе
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# БД для каждого сервиса (имена из docker/postgres/init-dbs.sql)
# account   -> account_db (account + profile в одном сервисе)
# words     -> words_db
# games     -> games_db

# JWT (account service)
JWT_SECRET=your-secret-change-in-production

# API Gateway HTTP port
PORT=3000
